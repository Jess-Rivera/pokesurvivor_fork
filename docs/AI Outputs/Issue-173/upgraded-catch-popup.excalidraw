            "link": null,
            "locked": false,
            "text": "The `Detail` toggle is added to the \"Catch\" panel. This pops up\na shortened pokemon detail panel.\n\nIt functions in the exact same way as the pokemon detail panel\nin the team menu except it does NOT have:\n- Level up button\n- OOR Level\n- Favorited/Locked Icons\n- Starting move box\n- Moves button\n",
            "fontSize": 10.714285714285714,
            "baseFontSize": 10.714285714285714,
            "fontFamily": 8,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": "CCepGm9_ef145r0lJeNXg",
            "originalText": "The `Detail` toggle is added to the \"Catch\" panel. This pops up a shortened pokemon detail panel.\n\nIt functions in the exact same way as the pokemon detail panel in the team menu except it does NOT have:\n- Level up button\n- OOR Level\n- Favorited/Locked Icons\n- Starting move box\n- Moves button\n",
            "autoResize": true,
            "lineHeight": 1.25,
            "labelPosition": null
        },
