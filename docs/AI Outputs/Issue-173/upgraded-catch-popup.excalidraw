            "updated": 1795781432709,
            "created": 1795781043286,
            "link": null,
            "locked": false,
            "text": "No more hover tooltip. Instead Hover Tooltip replaced with\nshortened pokemon detail panel, which appears when\nclicking/ENTER/SPACE on an owned copy in the owned copies box. \n\nIt functions in the exact same way as the pokemon detail panel\nin the team menu except it does NOT have:\n- Level up button\n- Starting move box\n- Moves button\n\nAn owned Copy DOES show its OOR Level and EXP Bar. It also\nshows its favorite/locked icon.",
            "fontSize": 10.714285714285714,
            "baseFontSize": 10.714285714285714,
            "fontFamily": 8,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": "SXeWMz6Vqflcl8H8-Gu7d",
            "originalText": "No more hover tooltip. Instead Hover Tooltip replaced with shortened pokemon detail panel, which appears when clicking/ENTER/SPACE on an owned copy in the owned copies box. \n\nIt functions in the exact same way as the pokemon detail panel in the team menu except it does NOT have:\n- Level up button\n- Starting move box\n- Moves button\n\nAn owned Copy DOES show its OOR Level and EXP Bar. It also shows its favorite/locked icon.",
            "autoResize": true,
            "lineHeight": 1.25,
            "labelPosition": null
        },
