{
  "about": "Stage 0 intent scenarios (docs/current feature planning/move-schema-post-auth/stage-0.md). Run by docs/proposals/move-intent-harness.js against the real sim for every routed move. Expected outcomes are written by hand from MOVE-INTENT (source MOVE-INTENT:<id>) or from the move data and the D-table (source data), never copied from the harness output. Layout: the owner stands at (0, 0) aiming along +x; enemies are [x, y] or [x, y, {overrides}] with radius 10 and huge HP. Defaults: owner cdMul 100 (one cast per scenario), rng never (every roll misses). Enemy indexes in expect are positions in the enemies list.",
  "batchReviewed": ["bite", "body-slam", "bulldoze", "dragon-rage", "ember", "giga-drain", "heat-wave", "hydro-pump", "mud-shot", "psycho-cut", "swords-dance", "water-gun"],
  "scenarios": [
    { "id": "tackle-arc", "move": "tackle", "source": "data", "secs": 0.4,
      "enemies": [[40, 0], [0, 45], [80, 0]],
      "expect": { "hits": [1, 0, 0] },
      "note": "arc 1.7 rad, radius 48: the enemy ahead is inside, one at 90 degrees is outside the arc, one at 80 px is past the reach" },

    { "id": "ember-pierce0", "move": "ember", "source": "data", "secs": 0.6,
      "enemies": [[100, 0], [140, 0]],
      "expect": { "hits": [1, 0], "ends": { "pierce": 1 }, "firstHit": { "0": [0.15, 0.35] } },
      "note": "pierce 0 stops on the first enemy; contact after about 83 px at 310 px/s" },
    { "id": "ember-range", "move": "ember", "source": "data", "secs": 1.7,
      "enemies": [[560, 0], [0, 300]],
      "expect": { "casts": 1, "hits": [0, 0], "ends": { "time": 1 } },
      "note": "1.6 s x 310 px/s = 496 px of travel along the aim, short of an enemy at 560. The second enemy (in range, off the aim line) is what lets a direction move cast at all (combat-architecture:H11 S2)" },

    { "id": "water-gun-pierce1", "move": "water-gun", "source": "data", "secs": 0.8,
      "enemies": [[100, 0], [150, 0], [200, 0]],
      "expect": { "hits": [1, 1, 0], "ends": { "pierce": 1 } },
      "note": "pierce 1 passes through one enemy and stops on the second" },

    { "id": "hydro-pump-band", "move": "hydro-pump", "source": "data", "secs": 0.6,
      "enemies": [[100, 0], [240, 0], [300, 0], [100, 30]],
      "expect": { "hits": [1, 1, 0, 0] },
      "note": "linear 250 x 30 aimed at the nearest: inside along 0 to 260 and within 25 px of the axis" },

    { "id": "heat-wave-grow", "move": "heat-wave", "source": "data", "secs": 0.5,
      "enemies": [[100, 0], [0, -200], [300, 0]],
      "expect": { "hits": [1, 1, 0], "firstHit": { "0": [0.12, 0.18], "1": [0.28, 0.34] } },
      "note": "circle grows from 1 px at 625 px/s to max 250 (D21): reaches 100 at about 0.14 s, 200 at about 0.30 s, never 300" },

    { "id": "mud-shot-ring", "move": "mud-shot", "source": "data", "secs": 0.6,
      "enemies": [[100, 0], [-100, 0], [0, 100]],
      "expect": { "hits": [1, 1, 0], "enemyStage": { "0": { "spe": -1 } } },
      "note": "6 projectiles evenly around the circle from the aim (0, 60, ... 300 degrees): 0 and 180 hit, 90 falls between two; foe Speed -1 (schema spd is stages spe, D31)" },

    { "id": "mud-shot-stack", "move": "mud-shot", "source": "data", "secs": 3, "owner": { "cdMul": 0.1 },
      "enemies": [[100, 0]],
      "expect": { "hitsMin": [7], "enemyStage": { "0": { "spe": -6 } } },
      "note": "slice 4c-0 (D-FOECAP): an uncapped foe drop stacks to the -6 ladder. cd 1.167 x 0.1 casts every 0.117 s, so far more than 6 hits land inside one 6 s duration; the stage reads -6, never past" },

    { "id": "flamethrower-interval", "move": "flamethrower", "source": "data", "secs": 1.1,
      "enemies": [[100, 0]],
      "expect": { "hits": [5] },
      "note": "interval rehit 0.2 over a 1 s instance: hits at ages dt, 0.2, 0.4, 0.6, 0.8 after the first" },
    { "id": "flamethrower-sticky", "move": "flamethrower", "source": "MOVE-INTENT:flamethrower", "secs": 1.1, "waitsFor": "slice 4c-3 (aimTrack)",
      "enemies": [[100, 0, { "hp": 1 }], [0, 100]],
      "expect": { "hitsMin": [1, 1], "firstHit": { "1": [0.5, 1.0] } },
      "note": "sticky aimTrack: the cast target dies on its first hit, then the cone turns toward the nearest at 1.4 rad/s and reaches the second enemy" },

    { "id": "body-slam-arc", "move": "body-slam", "source": "data", "secs": 0.4,
      "enemies": [[40, 0], [0, 60]],
      "expect": { "hits": [1, 0] },
      "note": "arc 2.2 rad, radius 46: the enemy at 60 px is past the reach" },

    { "id": "string-shot-double", "move": "string-shot", "source": "MOVE-INTENT:string-shot", "secs": 0.6,
      "enemies": [[100, 0]],
      "expect": { "hits": [2], "enemyStage": { "0": { "spe": -4 } }, "rooted": [0] },
      "note": "two projectiles on one line both land: Speed -2 twice is -4 (allowed), plus trap (root)" },

    { "id": "ice-beam-band", "move": "ice-beam", "source": "data", "secs": 0.6,
      "enemies": [[100, 0], [280, 0], [100, 25]],
      "expect": { "hits": [1, 1, 0], "enemyStage": { "0": { "spe": -1 } } },
      "note": "linear 290 x 20: inside to 300 along, within 20 px of the axis" },
    { "id": "ice-beam-cap", "move": "ice-beam", "source": "MOVE-INTENT:ice-beam", "secs": 3.6, "owner": { "cdMul": 1 },
      "enemies": [[100, 0]],
      "expect": { "casts": 3, "hits": [3], "enemyStage": { "0": { "spe": -1 } } },
      "note": "per-move rule: its foe Speed -1 has maxStacks 1, so three casts inside 6 s still read -1" },

    { "id": "bite-arc", "move": "bite", "source": "data", "secs": 0.4,
      "enemies": [[40, 0]],
      "expect": { "hits": [1] } },

    { "id": "psycho-cut-crit", "move": "psycho-cut", "source": "data", "secs": 0.4, "rng": "always",
      "enemies": [[40, 0]],
      "expect": { "hits": [1], "crit": true },
      "note": "crit effect 15%: a roll of 0 always crits" },

    { "id": "giga-drain-heal", "move": "giga-drain", "source": "data", "secs": 0.6, "owner": { "hp": 10, "maxHp": 1000 },
      "enemies": [[100, 0], [140, 0]],
      "expect": { "hits": [1, 0], "healFraction": 0.5 },
      "note": "heals half the damage dealt (D34; no Big Root here)" },

    { "id": "bulldoze-grow", "move": "bulldoze", "source": "data", "secs": 0.5,
      "enemies": [[100, 0], [250, 0]],
      "expect": { "hits": [1, 0], "firstHit": { "0": [0.15, 0.21] }, "enemyStage": { "0": { "spe": -1 } } },
      "note": "circle grows from 1 px at 500 px/s to max 200: reaches 100 at about 0.18 s, never 250" },

    { "id": "swords-dance-once", "move": "swords-dance", "source": "data", "secs": 0.2,
      "enemies": [],
      "expect": { "ownerStage": { "atk": 2 } } },
    { "id": "swords-dance-cap", "move": "swords-dance", "source": "data", "secs": 8.5, "owner": { "cdMul": 0.5 },
      "enemies": [],
      "expect": { "casts": 3, "ownerStage": { "atk": 2 } },
      "note": "maxStacks 1: recasts refresh the live raise instead of adding" },

    { "id": "dragon-dance-short", "move": "dragon-dance", "source": "MOVE-INTENT:dragon-dance", "secs": 5.1,
      "enemies": [],
      "expect": { "at": [ { "t": 1, "ownerStage": { "atk": 1, "spe": 1 } }, { "t": 5, "ownerStage": { "atk": 0, "spe": 0 } } ] },
      "note": "per-move exception: its 4 s raises may end before the 8 s cooldown" },

    { "id": "aqua-ring-tick", "move": "aqua-ring", "source": "MOVE-INTENT:aqua-ring", "secs": 3.5, "owner": { "maxHp": 160, "hp": 10 },
      "enemies": [],
      "expect": { "ownerHp": 40 },
      "note": "6.25% of 160 = 10 per second; three ticks by 3.5 s" },

    { "id": "substitute-cast", "move": "substitute", "source": "MOVE-INTENT:substitute", "secs": 0.5, "owner": { "hp": 100, "maxHp": 100 },
      "enemies": [],
      "expect": { "ownerHp": 75, "shield": 50 },
      "note": "pays 25% of max HP, raises a shield of twice that" },

    { "id": "dragon-rage-flat", "move": "dragon-rage", "source": "data", "secs": 0.6,
      "enemies": [[100, 0], [200, 0]],
      "expect": { "hits": [1, 1], "dmg": 40 },
      "note": "fixed 40 to everything in the band, no type or defense" },

    { "id": "hex-chain", "move": "hex", "source": "MOVE-INTENT:hex", "secs": 0.6,
      "enemies": [[100, 0], [200, 0]],
      "expect": { "hits": [1, 1], "ratios": { "1": 0.67 } },
      "note": "one hop within 150 px at x (1 - 0.33)" },

    { "id": "thunderbolt-chain", "move": "thunderbolt", "source": "MOVE-INTENT:thunderbolt", "secs": 0.3,
      "enemies": [[100, 0], [200, 0], [300, 0], [400, 0], [500, 0], [600, 0]],
      "expect": { "hits": [1, 1, 1, 1, 1, 0], "ratios": { "1": 0.67, "2": 0.4489, "3": 0.300763, "4": 0.20151121 } },
      "note": "4 hops at x (1 - 0.33)^k (combat-architecture:D15); the sixth enemy is past the last hop" },

    { "id": "fire-spin-riders", "move": "fire-spin", "source": "MOVE-INTENT:fire-spin", "secs": 0.3, "waitsFor": "slice 4c-1",
      "enemies": [[90, 0]],
      "expect": { "hitsMin": [1], "status": { "0": "burn" }, "rooted": [0] },
      "note": "an enemy on the orbit is hit, burned at the full standard length and trapped, no stat strip" },
    { "id": "night-shade-level", "move": "night-shade", "source": "MOVE-INTENT:night-shade", "secs": 1.2, "waitsFor": "slice 4c-1",
      "enemies": [[100, 0]],
      "expect": { "hits": [3], "dmg": 30 },
      "note": "ring of 120 px, rehit 0.5, damage equal to the owner level (30)" },
    { "id": "leaf-storm-selfdrop", "move": "leaf-storm", "source": "MOVE-INTENT:leaf-storm", "secs": 1.0, "waitsFor": "slice 4c-1",
      "enemies": [[95, 0]],
      "expect": { "hitsMin": [1], "ownerStage": { "spa": -2 } },
      "note": "an enemy on the orbit is hit many times; the self Sp. Atk drop holds at -2, never -4 (maxStacks 1)" },
    { "id": "leaf-storm-nohit", "move": "leaf-storm", "source": "MOVE-INTENT:leaf-storm", "secs": 1.0, "waitsFor": "slice 4c-1",
      "enemies": [],
      "expect": { "ownerStage": { "spa": 0 } },
      "note": "D-LEAF: the drop refreshes on hit, so with nothing in reach it never applies" },

    { "id": "razor-leaf-legs", "move": "razor-leaf", "source": "MOVE-INTENT:razor-leaf", "secs": 1.6, "waitsFor": "slice 4c-2",
      "enemies": [[145.34, 37.11], [145.34, -37.11]],
      "expect": { "hits": [2, 2] },
      "note": "two leaves at +-0.25 rad, range 210: an enemy on each path takes one hit per leg" },
    { "id": "bonemerang-legs", "move": "bonemerang", "source": "MOVE-INTENT:bonemerang", "secs": 1.9, "waitsFor": "slice 4c-2",
      "enemies": [[145.34, 37.11], [145.34, -37.11]],
      "expect": { "hits": [2, 2] },
      "note": "two bones at +-0.25 rad, range 230: 2 hits per enemy per bone, one per leg" },
    { "id": "quick-attack-return", "move": "quick-attack", "source": "MOVE-INTENT:quick-attack", "secs": 0.6, "waitsFor": "slice 4c-2",
      "enemies": [[200, 0]],
      "expect": { "hits": [1], "casterEnd": [0, 0, 1] },
      "note": "dash to the target's centre, hit once there, return to the start" },
    { "id": "aerial-ace-teleport", "move": "aerial-ace", "source": "data", "secs": 0.3, "waitsFor": "slice 4c-2",
      "enemies": [[200, 0]],
      "expect": { "hits": [1] } },

    { "id": "psychic-ahead", "move": "psychic", "source": "MOVE-INTENT:psychic", "secs": 1.3, "waitsFor": "slice 4c-3",
      "enemies": [[120, 0]],
      "expect": { "hits": [1] } },
    { "id": "psychic-repick", "move": "psychic", "source": "MOVE-INTENT:psychic", "secs": 1.3, "waitsFor": "slice 4c-3",
      "enemies": [[120, 0, { "hp": 1 }], [60, 90]],
      "expect": { "hitsMin": [1, 1] },
      "note": "D-PSY: the cast target dies on its first hit, the wedge re-picks the nearest live enemy once and reaches it. Exact timing is checked by the 4c-3 handoff Test 6" },
    { "id": "confusion-homing", "move": "confusion", "source": "data", "secs": 0.8, "waitsFor": "slice 4c-3",
      "enemies": [[0, 100]],
      "expect": { "hits": [1] } },
    { "id": "bubble-beam-hit", "move": "bubble-beam", "source": "data", "secs": 0.8, "waitsFor": "slice 4c-3",
      "enemies": [[150, 0]],
      "expect": { "hitsMin": [1] } },
    { "id": "aura-sphere-reach", "move": "aura-sphere", "source": "MOVE-INTENT:aura-sphere", "secs": 2.1, "waitsFor": "slice 4c-3",
      "enemies": [[300, 0]],
      "expect": { "hits": [0] },
      "note": "curving orbs reach about 160 px (2 x 80 x sin(1.5)), so an enemy at 300 is never hit" },
    { "id": "rock-slide-delay", "move": "rock-slide", "source": "MOVE-INTENT:rock-slide", "secs": 0.8, "waitsFor": "slice 4c-3",
      "enemies": [[200, 0]],
      "expect": { "hits": [1], "firstHit": { "0": [0.4, 0.7] } },
      "note": "one boulder on the only enemy in range, after the 0.4 s telegraph" }
  ]
}
