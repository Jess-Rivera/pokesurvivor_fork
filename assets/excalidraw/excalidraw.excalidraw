      "text": "Portraits of Gym Leader's Team reside in grey circles below hp bar. \nCircle only shows if there is a pokemon in that slot. Circle becomes darkly dimmed\nwhen pokemon is fainted.",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "fGU0KcG4F2xL__TUxzAZh",
      "originalText": "Portraits of Gym Leader's Team reside in grey circles below hp bar. \nCircle only shows if there is a pokemon in that slot. Circle becomes darkly dimmed when pokemon is fainted.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
