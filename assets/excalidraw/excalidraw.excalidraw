      "link": null,
      "locked": false,
      "text": "Team Roster slots. Portraits in grey circles. HP bars\nin red. Held items in light grey square to right.\nNumbers in corner are the `key_bind` for that slot",
      "fontSize": 10.714285714285714,
      "baseFontSize": 10.714285714285714,
      "fontFamily": 5,
      "textAlign": "center",
