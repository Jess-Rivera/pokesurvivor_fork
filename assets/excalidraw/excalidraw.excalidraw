      "created": 1794445686946,
      "link": null,
      "locked": false,
      "text": "Each row slides out with a bounce stop on hover/select.\nThe snap back in with a bounce stop on deselect/unfocus.\nThe two animations overlap slightly, but once everything is settled, only one row is\nout(keyboard controls) or none (mouse has none of them focused.)",
      "fontSize": 8.694063926940636,
      "baseFontSize": 8.694063926940636,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "5ihhoiVwkhjFrUxBDFjbZ",
      "originalText": "Each row slides out with a bounce stop on hover/select.\nThe snap back in with a bounce stop on deselect/unfocus.\nThe two animations overlap slightly, but once everything is settled, only one row is out(keyboard controls) or none (mouse has none of them focused.)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
