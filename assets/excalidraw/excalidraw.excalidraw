    {
      "id": "U84W3nFcwC2PQJuLxXvjj",
      "type": "text",
      "x": 3565.0467704088996,
      "y": 2567.2358857158865,
      "width": 519.8499755859375,
      "height": 380,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "mgRsSsl4D9Q8FmkBsdSEZ",
      "index": "bDnWV",
      "roundness": null,
      "seed": 133360937,
      "version": 1489,
      "versionNonce": 1306216007,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794417266036,
      "created": 1794416257484,
      "link": null,
      "locked": false,
      "text": "TMs Screen\n`Item Description` Replaced with TM Icon of the appropriate\ntype.\n`Item Description` replaced with the move name of the TM and\nType Chip under it.\nGold Cost in bottom right corner. \n\nRight Panel as active pokemon as the big portrait. under that is\nthe team roster. The team roster automatically dims pokemon who\ncan't learn the TM.\nSeperation bar to a condensed version of the team menu, with\nsearch bar and dropdown filter [types].\nThe condensed team menu will automatically update when a TM is\nclicked/hovered over to show all pokemon who can learn it.\nPurchased TM's for a pokemon[by UUID] move that TM to its\nlearnset so it shows up in the Move Mart in the run. It can also\nbe selected as a starting move on the Team Menu[Upgrades\nMenu].\n",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": "LTDcNpqJvHqVmL17InbRa",
      "originalText": "TMs Screen\n`Item Description` Replaced with TM Icon of the appropriate type.\n`Item Description` replaced with the move name of the TM and Type Chip under it.\nGold Cost in bottom right corner. \n\nRight Panel as active pokemon as the big portrait. under that is the team roster. The team roster automatically dims pokemon who can't learn the TM.\nSeperation bar to a condensed version of the team menu, with search bar and dropdown filter [types].\nThe condensed team menu will automatically update when a TM is clicked/hovered over to show all pokemon who can learn it.\nPurchased TM's for a pokemon[by UUID] move that TM to its learnset so it shows up in the Move Mart in the run. It can also be selected as a starting move on the Team Menu[Upgrades Menu].\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
