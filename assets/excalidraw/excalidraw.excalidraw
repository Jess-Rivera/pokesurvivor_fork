      "updated": 1794417266036,
      "created": 1794416257483,
      "link": null,
      "locked": false,
      "text": "Grid displaying items per tab selected:\nCharacter: berry slot upgrade, run item slot upgrade,\nmaybe more\nHeld Items: Items that you have seen before can be\npurchased as an item for your pokemon to start a run\nwith. Very Expensive.\nPokeballs: working tab for new pokemon acquisition\nmethod\nResearch: working tab for new pokemon acquisition method",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "g7VUuTnx-1BJUToxAprCC",
      "originalText": "Grid displaying items per tab selected:\nCharacter: berry slot upgrade, run item slot upgrade, maybe more\nHeld Items: Items that you have seen before can be purchased as an item for your pokemon to start a run with. Very Expensive.\nPokeballs: working tab for new pokemon acquisition method\nResearch: working tab for new pokemon acquisition method",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
