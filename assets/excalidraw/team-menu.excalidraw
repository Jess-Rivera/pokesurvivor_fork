8.0310155585316,"width":528.7649648254,"height":661.5433134724492,"angle":0,"strokeColor":"#20a048","backgroundColor":"#e9ecef","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":"KiZnInf45DY03MmzX3woE","index":"bU7zzzzzzzzzzzzvp","roundness":null,"seed":1162490162,"version":1108,"versionNonce":885701022,"isDeleted":false,"boundElements":[{"type":"text","id":"9smtInYCLCqBHLkMdHydL"},{"id":"PsXoBtP1ZAl-1mwnWzcp5","type":"arrow"}],"updated":1795461036428,"created":1795437129513,"link":null,"locked":false,"baseHeight":205.17731141007886},{"id":"9smtInYCLCqBHLkMdHydL","type":"text","x":3868.5658865216515,"y":-3522.0310155585316,"width":495.35000610351563,"height":609.5433134724492,"angle":0,"strokeColor":"#20a048","backgroundColor":"#181818","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":"KiZnInf45DY03MmzX3woE","index":"bU7zzzzzzzzzzzzvt","roundness":null,"seed":1490050226,"version":2277,"versionNonce":1569568578,"isDeleted":false,"boundElements":[],"updated":1795461036428,"created":1795437219563,"link":null,"locked":false,"text":"Back panel uses pause.pokemonDetail.background. \n{Name/Nickname}{Gender} and {Favorite Icon}{LockedIcon} go\nin the top color bar like the current name do in the current\npause menu. #ffffff color, font.silver\nOOR Level EXP bar: \n   - EXP top: #00baf3\n   - EXP bottom: #0d7f9d\n   - EXP empty top: #828282\n   - EXP empty bottom: #e7e7e7\n{Out of run Level} goes where the HP bar was. {TypeChip1}\n{TypeChip2} are right justified against the 45deg section. OOR\nlevel #ffffff, font.michroma\nLevel Up button uses neutral button. Single click gives EXP\nCandy until next full level. Shift-Click gives EXP to reach +10\nlevel. \"Give Until\" can be removed.\nStat Bars box uses the reference image where the numbers in\nfront of the bar are the base stat (Including per-pokemon\nupgrades). the bar is two pixels tall. the numbers on the right\nof the bar is the IV/EV value. the top bar is the IV value 0-31\nin color.stat*.light and the bottom bar is the EV value 0-252 in\ncolor.stat*.dark. Stat names use color.stat*.base. all text in\nfont.micrhoma \nThe toggle switches the Stat Bars section to our stat HEX\nusing the CRT off → on effect with the content of the box.\nthe box itself remains static.  \nNature #ffffff font.michroma\nAbility #ffffff font.michroma\nStarting Move box font.michroma colors as listed\n\nMoves button uses neutral button\nEXP Bag uses neutral button and opens EXP Bag Hover Pop-Up","fontSize":15.730150025095462,"baseFontSize":15.730150025095462,"fontFamily":5,"textAlign":"left","verticalAlign":"top","containerId":"kXjQzzqRSshzjYnP4LxOS","originalText":"Back panel uses pause.pokemonDetail.background. \n{Name/Nickname}{Gender} and {Favorite Icon}{LockedIcon} go in the top color bar like the current name do in the current pause menu. #ffffff color, font.silver\nOOR Level EXP bar: \n   - EXP top: #00baf3\n   - EXP bottom: #0d7f9d\n   - EXP empty top: #828282\n   - EXP empty bottom: #e7e7e7\n{Out of run Level} goes where the HP bar was. {TypeChip1}{TypeChip2} are right justified against the 45deg section. OOR level #ffffff, font.michroma\nLevel Up button uses neutral button. Single click gives EXP Candy until next full level. Shift-Click gives EXP to reach +10 level. \"Give Until\" can be removed.\nStat Bars box uses the reference image where the numbers in front of the bar are the base stat (Including per-pokemon upgrades). the bar is two pixels tall. the numbers on the right of the bar is the IV/EV value. the top bar is the IV value 0-31 in color.stat*.light and the bottom bar is the EV value 0-252 in color.stat*.dark. Stat names use color.stat*.base. all text in font.micrhoma \nThe toggle switches the Stat Bars section to our stat HEX using the CRT off → on effect with the content of the box. the box itself remains static.  \nNature #ffffff font.michroma\nAbility #ffffff font.michroma\nStarting Move box font.michroma colors as listed\n\nMoves button uses neutral button\nEXP Bag uses neutral button and opens EXP Bag Hover Pop-Up","autoResize":true,"lineHeight":1.25,"labelPosition":null},{"id":"PsXoBtP1ZAl-1mwnWzcp5","type":"arrow","x":3847.0658865216519,"y":-3207.1973970594968,"width":35.396089857864808,"height":0.026981915031228709,"angle":0,"strokeColor":"#f08c00","backgroundColor":"#181818","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":"KiZnInf45DY03MmzX3woE","index":"bU7zzzzzzzzzzzzvx","roundness":{"type":2},"seed":446764910,"version":462,"versionNonce":1842498946,"isDeleted":false,"boundElements":[],"updated":1795461036429,"created":1795437843440,"link":null,"locked":false,"points":[[0,0],[-35.396089857864808,-0.026981915031228709]],"startBinding":{"elementId":"kXjQzzqRSshzjYnP4LxOS","mode":"orbit","fixedPoint":[0,0.5001]},"endBinding":null,"startArrowhead":null,"endArrowhead":"triangle","elbowed":false},{"id":"MzRkJVLf04aVQLUNQ_Xrb","type":"rectangle","x":2547.9930761470305,"y":-3503.8782640194941,"width":782.548569129383,"height":690.16021677295737,"angle":0,"strokeColor":"#495151","backgroundColor":"#181818","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":"KiZnInf45DY03MmzX3woE","index":"bU7zzzzzzzzzzzzw","roundness":{"type":3},"seed":1438354286,"version":459,"versionNonce":1231340446,"isDeleted":false,"boundElements":[{"id":"--5eSCnnL-gND3el5gNHy","type":"arrow"}],"updated":1795461036429,"created":1795437919111,"link":null,"locked":false},{"id":"bp3tMHv3iA7EdVxWvJesl","type":"stickynote","x":2231.9036736462213,"y":-3847.2879115504393,"width":485.78523141849229,"height":172,"angle":0,"strokeColor":"#20a048","backgroundColor":"#e9ecef","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"groupIds":[],"frameId":"KiZnInf45DY03MmzX3woE","index":"bU7zzzzzzzzzzzzw4","roundness"