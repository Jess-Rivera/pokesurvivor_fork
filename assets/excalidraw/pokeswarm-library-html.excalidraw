      "seed": 135141065,
      "version": 1151,
      "versionNonce": 1906262059,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794966555772,
      "created": 1794835054413,
      "link": null,
      "locked": false,
      "text": "Containers: All use same border shape as {IV, Moves, Cards Taken, Run Stats} boxes in Pokemon\nDetail screen in pause menu\nPokemon Info: Colored by Type of pokemon. Dual color has Left border primary type, right border\nsecondary type with a gradient between the two colors on the top/bottom border.\nBelts: Poke Balls pocket        #DBB26E        #C88820        #825815\nPokemon Owned: #C1C2C1        #9FA19F        #676967",
      "fontSize": 10.714285714285714,
      "baseFontSize": 10.714285714285714,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lLwo85TFMEBT6TmK_kqAa",
      "originalText": "Containers: All use same border shape as {IV, Moves, Cards Taken, Run Stats} boxes in Pokemon Detail screen in pause menu\nPokemon Info: Colored by Type of pokemon. Dual color has Left border primary type, right border secondary type with a gradient between the two colors on the top/bottom border.\nBelts: Poke Balls pocket        #DBB26E        #C88820        #825815\nPokemon Owned: #C1C2C1        #9FA19F        #676967",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
