    {
      "id": "H3ZgCUT2Fa9WynkbvkOuL",
      "type": "text",
      "x": 8435.77908081597,
      "y": -4032.0476880253677,
      "width": 379.3500061035156,
      "height": 80.35714285714286,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "oU8Qbw1BGXxhGH9bEcw7-",
      "index": "bJazzzzzzzzx",
