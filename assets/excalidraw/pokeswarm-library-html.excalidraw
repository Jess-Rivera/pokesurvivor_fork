    {
      "id": "xKL74ajD4SKtKlGwEssmD",
      "type": "text",
      "x": 7828.54116011025,
      "y": -4030.7947804968353,
      "width": 512.566650390625,
      "height": 80.35714285714286,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#1e1e1e",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dotted",
