      "link": null,
      "locked": false,
      "text": "Menu Popup Panel\n#212121 frame, #181818 panel body\n\nBuying a TR\n\nDisplays a Confirmation PopUp:\n#212121 frame, #181818 panel body, White text\n\"Teach {Active Pokemon Name/Nickname} {TR name}\"?\nYes Button:\nUnfocused: standard #ffffff rim, #181818 flat body,\nWhite text\nFocused: #38d030 rim, #181818 body, White text\nNo Button: \nUnfocused: standard #ffffff rim, #181818 flat body,\nWhite text\nFocused: #e8202a rim, #ff8a90 body, White text",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "g96ZZHDah4vio0S8jAMKa",
      "originalText": "Menu Popup Panel\n#212121 frame, #181818 panel body\n\nBuying a TR\n\nDisplays a Confirmation PopUp:\n#212121 frame, #181818 panel body, White text\n\"Teach {Active Pokemon Name/Nickname} {TR name}\"?\nYes Button:\nUnfocused: standard #ffffff rim, #181818 flat body, White text\nFocused: #38d030 rim, #181818 body, White text\nNo Button: \nUnfocused: standard #ffffff rim, #181818 flat body, White text\nFocused: #e8202a rim, #ff8a90 body, White text",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
