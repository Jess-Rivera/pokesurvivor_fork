      "version": 1825,
      "versionNonce": 2058999339,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794966555772,
      "created": 1794872764402,
      "link": null,
      "locked": false,
      "text": "Pocket Upgrades\n\nBerry Pocket: \nUses the same shape as the Move Slot/Cards Taken/Run Stats panel from the Pokemon Detail Panel in the Pause Menu.\nBerries Pocket Base color from Reference Palette #20A048 rim with #303030 panel.\nShows the 2x2 grid of the Berry slots from the pause screen, with the appropriate amount of slots dimmed based on\nhow many have been purchased. \nDivider line #495151 between image and panel text, does not reach rim.\nDescription: \"Berry Pocket\" in #8cfff7, \"Holds Berries during a run.\" in White.\n\nTeam Item Pocket\nUses the same shape as the Move Slot/Cards Taken/Run Stats panel from the Pokemon Detail Panel in the Pause Menu.\nTeam Items Pocket Base color from Reference Palette #c86890rim with #303030 panel. \nShows the 2x2 grid of the Team Item slots from the pause screen, with the appropriate amount of slots dimmed based\non how many have been purchased. \nDivider line #495151 between image and panel text, does not reach rim.\nDescription: \"Team Items Pocket\" in #8cfff7, \"Holds Team Items during a run.\" in White.\n",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "xdbitYe13zTZduFfi-HFe",
      "originalText": "Pocket Upgrades\n\nBerry Pocket: \nUses the same shape as the Move Slot/Cards Taken/Run Stats panel from the Pokemon Detail Panel in the Pause Menu.\nBerries Pocket Base color from Reference Palette #20A048 rim with #303030 panel.\nShows the 2x2 grid of the Berry slots from the pause screen, with the appropriate amount of slots dimmed based on how many have been purchased. \nDivider line #495151 between image and panel text, does not reach rim.\nDescription: \"Berry Pocket\" in #8cfff7, \"Holds Berries during a run.\" in White.\n\nTeam Item Pocket\nUses the same shape as the Move Slot/Cards Taken/Run Stats panel from the Pokemon Detail Panel in the Pause Menu.\nTeam Items Pocket Base color from Reference Palette #c86890rim with #303030 panel. \nShows the 2x2 grid of the Team Item slots from the pause screen, with the appropriate amount of slots dimmed based on how many have been purchased. \nDivider line #495151 between image and panel text, does not reach rim.\nDescription: \"Team Items Pocket\" in #8cfff7, \"Holds Team Items during a run.\" in White.\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "AT-8_DHtTNzCdHZLJxkaT",
      "type": "rectangle",
      "x": 2373.3018519376187,
      "y": 2416.983714104387,
      "width": 151.43296472163053,
      "height": 222.74836932218952,
      "angle": 0,
      "strokeColor": "#20a048",
