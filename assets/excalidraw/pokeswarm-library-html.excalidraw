    {
      "id": "z7wyTTujeow6cjJGfvnZ3",
      "type": "text",
      "x": 2683.36456433671,
      "y": 269.2702997857218,
      "width": 1005.2666625976562,
      "height": 360,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#181818",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "c0odaWtEu_BY4ztak3GaD",
      "index": "bDI5",
      "roundness": null,
      "seed": 185374211,
      "version": 1968,
      "versionNonce": 1154404843,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794966555772,
      "created": 1794868703568,
      "link": null,
      "locked": false,
      "text": "Container holding 3 columns of pokeball info/purchase cards. there 17 balls, so 3colx5row and 2col for the 4th row. Scroll bar.\n\nPokeball Info/Purchase Card: \nIf not unlocked, entire panel is dimmed.\n#29ceff thin rim, #303030 panel body\nImage from `icons\\pokeball\\balls\\*.png` slot 10 flipped horizontally or maybe `icons\\pokeball\\Poke_balls.png`\nDivider line #495151 between image and panel text, does not reach rim.\nPanel Text: Name #8cfff7 on its own line. Smaller text is short description of pokeball in #white.\nBuy Button  \nAllows purchase of ball. temporary prices. use the menu button (same as Team Menu and Catch Menu without icons). Initial Text\nsays \"Unlock $N\". after unlock it has \"Buy $N\". Shift-Click allows purchasex10.\nUnfocused: standard #ffffff rim, #181818 flat body, White text if able to purchase, White@45% if unable to afford\nFocused (only focuses if able to afford): #38d030 rim, #181818 body, White text\n\n//Fushcia box is just used to show that the Pokeball Info Cards do not extend past the container they are placed in\n \n\n",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "_Bj4gX2O2Wk4kEsUiN55F",
      "originalText": "Container holding 3 columns of pokeball info/purchase cards. there 17 balls, so 3colx5row and 2col for the 4th row. Scroll bar.\n\nPokeball Info/Purchase Card: \nIf not unlocked, entire panel is dimmed.\n#29ceff thin rim, #303030 panel body\nImage from `icons\\pokeball\\balls\\*.png` slot 10 flipped horizontally or maybe `icons\\pokeball\\Poke_balls.png`\nDivider line #495151 between image and panel text, does not reach rim.\nPanel Text: Name #8cfff7 on its own line. Smaller text is short description of pokeball in #white.\nBuy Button  \nAllows purchase of ball. temporary prices. use the menu button (same as Team Menu and Catch Menu without icons). Initial Text says \"Unlock $N\". after unlock it has \"Buy $N\". Shift-Click allows purchasex10.\nUnfocused: standard #ffffff rim, #181818 flat body, White text if able to purchase, White@45% if unable to afford\nFocused (only focuses if able to afford): #38d030 rim, #181818 body, White text\n\n//Fushcia box is just used to show that the Pokeball Info Cards do not extend past the container they are placed in\n \n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
