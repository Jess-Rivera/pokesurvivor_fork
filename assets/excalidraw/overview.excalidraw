    {
      "id": "H3ZgCUT2Fa9WynkbvkOuL",
      "type": "text",
      "x": 8572.445747482638,
      "y": -4028.714354692034,
      "width": 379.3500061035156,
      "height": 80.35714285714286,
      "angle": 0,
      "strokeColor": "#2f9e44",
