      "updated": 1795461036429,
      "created": 1795460457670,
      "link": null,
      "locked": false,
      "text": "EXP Candy Bag hover Popup uses panel.pixel using\ncolor.pocketKeyItems.*\nEXP Candy Icons inside well\nDiamond is replaced with pin symbol for pinning the\nhover\nOnce pinned, can be dragged around screen. \nClick and drag for one item. \nCtrl-Click to add one more to \"held\".\nShift-Click and Drag for 10. \nCtrl-Shift-Click adds 10 to \"held\".\n",
      "fontSize": 16,
      "baseFontSize": 19.151515151515113,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "_YmoGSzSK9kZYRzY_IjCO",
      "originalText": "EXP Candy Bag hover Popup uses panel.pixel using color.pocketKeyItems.*\nEXP Candy Icons inside well\nDiamond is replaced with pin symbol for pinning the hover\nOnce pinned, can be dragged around screen. \nClick and drag for one item. \nCtrl-Click to add one more to \"held\".\nShift-Click and Drag for 10. \nCtrl-Shift-Click adds 10 to \"held\".\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
