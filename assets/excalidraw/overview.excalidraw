      "seed": 444312169,
      "version": 1221,
      "versionNonce": 528934105,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795226724748,
      "created": 1794835591015,
      "link": null,
      "locked": false,
      "text": "Buttons: Uses the same button shape as in team menu, inventory menu,\nsettings menu from the Main Menu. No X or U icons. #ffffff rim, #181818\nflat body.\nUnfocused: \"Throw\" using White, and \"Let It Go\" using White@45%\nFocused: \"Throw\" becomes #38d030 rim,  \"Let It Go\" text becomes\nWhite@100%, #ff8a90 / #e8202a / #7c1016 rim, #7c1016 body",
      "fontSize": 10.714285714285714,
      "baseFontSize": 10.714285714285714,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "fdNx9y8NmJ351XoYkf9Ko",
      "originalText": "Buttons: Uses the same button shape as in team menu, inventory menu, settings menu from the Main Menu. No X or U icons. #ffffff rim, #181818 flat body.\nUnfocused: \"Throw\" using White, and \"Let It Go\" using White@45%\nFocused: \"Throw\" becomes #38d030 rim,  \"Let It Go\" text becomes White@100%, #ff8a90 / #e8202a / #7c1016 rim, #7c1016 body",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
