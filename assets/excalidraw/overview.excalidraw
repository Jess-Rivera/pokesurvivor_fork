      "updated": 1795461036429,
      "created": 1795438300519,
      "link": null,
      "locked": false,
      "text": "Filter dropdown uses an accordian selection\nfor Region, Type, Rarity, BST. Additional\nnon accordian options of Favorite, Locked.\nBox N Dropdown includes Pokedex, Box 1-N\nwhere N is unlocked Boxes. Locked boxes can\nbe unlocked in Character Upgrade Shop.",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "wrRxmBCvvVcFFzmGrd5IF",
      "originalText": "Filter dropdown uses an accordian selection for Region, Type, Rarity, BST. Additional non accordian options of Favorite, Locked.\nBox N Dropdown includes Pokedex, Box 1-N where N is unlocked Boxes. Locked boxes can be unlocked in Character Upgrade Shop.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
