    {
      "id": "Ts1D4jYHfvBjXKRalfNSb",
      "type": "text",
      "x": 2752.554219287669,
      "y": 3241.306468829931,
      "width": 1022.1166381835938,
      "height": 280,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#181818",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
