    {
      "id": "OdXu89HuQ96cWwI70Td8Y",
      "type": "text",
      "x": 3827.428080487847,
      "y": 3391.7601620368137,
      "width": 441.1000061035156,
      "height": 280,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#303030",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": "mgRsSsl4D9Q8FmkBsdSEZ",
      "index": "bDnzzh",
      "roundness": null,
      "seed": 420704749,
      "version": 853,
      "versionNonce": 1795749763,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794880751057,
      "created": 1794874034477,
      "link": null,
      "locked": false,
      "text": "Uses the same shape as the Move Slot/Cards\nTaken/Run Stats panel from the Pokemon Detail Panel\nin the Pause Menu.\nBorder color #9FA19F, #303030 panel\n\nActive Pokemon Portrait with 6 pokemon slots for\nwhat's currently in the team. Active Pokemon's name or\nnickname is in White.\nDivider line #495151 between image and panel text, does\nnot reach rim.\nSearch bar that matches name and dropdown filter for\npokebox#, region, type, BST stars, Rarity\n3x3 portrait in scrollable container displays based on\nfilter. If no filter displays pokebox 1 sorted by dex",
      "fontSize": 16,
      "baseFontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "QHWuhCzp51BHBixUDS1GN",
      "originalText": "Uses the same shape as the Move Slot/Cards Taken/Run Stats panel from the Pokemon Detail Panel in the Pause Menu.\nBorder color #9FA19F, #303030 panel\n\nActive Pokemon Portrait with 6 pokemon slots for what's currently in the team. Active Pokemon's name or nickname is in White.\nDivider line #495151 between image and panel text, does not reach rim.\nSearch bar that matches name and dropdown filter for pokebox#, region, type, BST stars, Rarity\n3x3 portrait in scrollable container displays based on filter. If no filter displays pokebox 1 sorted by dex",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
