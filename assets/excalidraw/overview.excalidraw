      "version": 1035,
      "versionNonce": 1370370562,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795461036428,
      "created": 1795436225786,
      "link": null,
      "locked": false,
      "text": "Uses panel.pixel as used by the run.hud.teamSlot\nPortrait and Name. Type chips where HP bar is on\nthe run.hud.teamSlot.\nHas a `Upgrade` on the upper right corner where\nmajor status is on run.hud.teamSlot for opening the\nupgrade popup. Has `Level Up` in upper right corner\nthat follows same behavior as other box explained.\nBottom right has a favorite toggle and a\nlock/unlock toggle.",
      "fontSize": 16,
      "baseFontSize": 19.151515151515113,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "arEDOvynaKXz-NzbnzTXM",
      "originalText": "Uses panel.pixel as used by the run.hud.teamSlot\nPortrait and Name. Type chips where HP bar is on the run.hud.teamSlot.\nHas a `Upgrade` on the upper right corner where major status is on run.hud.teamSlot for opening the upgrade popup. Has `Level Up` in upper right corner that follows same behavior as other box explained.\nBottom right has a favorite toggle and a lock/unlock toggle.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
