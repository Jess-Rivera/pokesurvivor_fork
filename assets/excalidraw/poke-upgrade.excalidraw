            "updated": 1795461026945,
            "created": 1795443630731,
            "link": null,
            "locked": false,
            "text": "Portrait is large, maybe 3x or 4x size? \n{name/nickname} #ffffff font.michroma\nSummary panel uses panel.clean.edgeTeal\n- All text is #ffffff\n- Divider bar uses #495151\n\nBase = pokemon base stat per pokeAPI\n+%% = current sum of upgrades purchased\nNew Base = current total of Base+%%. \nOn hover of purchasing an upgrade the appropriate row will update its +%% and\nNew Base and change font color to #38d030\n",
            "fontSize": 16,
            "baseFontSize": 19.151515151515113,
            "fontFamily": 5,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": "O0522pLX7dRVbnzP992SF",
            "originalText": "Portrait is large, maybe 3x or 4x size? \n{name/nickname} #ffffff font.michroma\nSummary panel uses panel.clean.edgeTeal\n- All text is #ffffff\n- Divider bar uses #495151\n\nBase = pokemon base stat per pokeAPI\n+%% = current sum of upgrades purchased\nNew Base = current total of Base+%%. \nOn hover of purchasing an upgrade the appropriate row will update its +%% and New Base and change font color to #38d030\n",
            "autoResize": true,
            "lineHeight": 1.25,
            "labelPosition": null
        },
