            "boundElements": [
            ],
            "updated": 1795461026945,
            "created": 1795443381747,
            "link": null,
            "locked": false,
            "text": "Critical Hit edge uses #ef4179.\nCooldown edge uses #00baf3.\nBench Regeneration uses #9141cb\nStarting Move Choice uses #eb5628\n(color.attackPhysical.base) or #375ab2\n(color.attackSpecial.base) depending on the higher\nstat of the pokemon\nUses the positive intent button if able to purchase. \nIf unable to afford uses the positive refused.\nIf capped by OOR Level uses disabled.\nTitle of card uses #fff000. Description uses\n#ffffff.\nAll fonts are font.michroma.\n//Names in sketch override Reflexes and Synthesis\nnames.",
            "fontSize": 16,
            "baseFontSize": 19.151515151515113,
            "fontFamily": 5,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": "JC6LN1t4rjePJuPcjnkpu",
            "originalText": "Critical Hit edge uses #ef4179.\nCooldown edge uses #00baf3.\nBench Regeneration uses #9141cb\nStarting Move Choice uses #eb5628 (color.attackPhysical.base) or #375ab2 (color.attackSpecial.base) depending on the higher stat of the pokemon\nUses the positive intent button if able to purchase. \nIf unable to afford uses the positive refused.\nIf capped by OOR Level uses disabled.\nTitle of card uses #fff000. Description uses #ffffff.\nAll fonts are font.michroma.\n//Names in sketch override Reflexes and Synthesis names.",
            "autoResize": true,
            "lineHeight": 1.25,
            "labelPosition": null
        },
