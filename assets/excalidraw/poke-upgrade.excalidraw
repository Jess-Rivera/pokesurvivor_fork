        {
            "id": "rWu0g6CHlj6UXBW0Jb-QU",
            "type": "text",
            "x": 1742.2702728749837,
            "y": -1979.9500531608796,
            "width": 416.23333740234375,
            "height": 400,
            "angle": 0,
            "strokeColor": "#20a048",
            "backgroundColor": "#101010",
            "fillStyle": "solid",
            "strokeWidth": 1,
            "strokeStyle": "solid",
            "roughness": 0,
            "opacity": 100,
            "groupIds": [
            ],
            "frameId": "LQLi2e4s41klNVDjuW5qb",
            "index": "bU9E",
            "roundness": null,
            "seed": 469423406,
            "version": 2029,
            "versionNonce": 2118871262,
            "isDeleted": false,
            "boundElements": [
            ],
            "updated": 1795461026945,
            "created": 1795443149944,
            "link": null,
            "locked": false,
            "text": "Each stat upgrade uses panel.clean with the edge at\ncolor.stat*.base\nThe square upgrade pips indicate how many have\nbeen purchased. locked until OOR uses #495151 edge\nand dims the pip.\nUses the positive intent button if able to purchase,\nwith price as text. \nIf unable to afford uses the positive refused, with\nprice as text.\nIf capped by OOR Level uses disabled, with \"Needs\nLv N\" as text.\nOnce fully capped, card no longer has the button for\npurchasing. The edge of the panel gets a white shine\nthat circles the card. \nTitle of card uses #fff000. Description uses\n#ffffff.\nAll fonts are font.michroma.\n//For special cases such as Shedinja, the pips and\nbuttons are disabled. Button text \"Disabled\" with\nhover tooltip as to reason.",
            "fontSize": 16,
            "baseFontSize": 19.151515151515113,
            "fontFamily": 5,
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": "7FAzYqjN5lC6LErs1Lrtn",
            "originalText": "Each stat upgrade uses panel.clean with the edge at color.stat*.base\nThe square upgrade pips indicate how many have been purchased. locked until OOR uses #495151 edge and dims the pip.\nUses the positive intent button if able to purchase, with price as text. \nIf unable to afford uses the positive refused, with price as text.\nIf capped by OOR Level uses disabled, with \"Needs Lv N\" as text.\nOnce fully capped, card no longer has the button for purchasing. The edge of the panel gets a white shine that circles the card. \nTitle of card uses #fff000. Description uses #ffffff.\nAll fonts are font.michroma.\n//For special cases such as Shedinja, the pips and buttons are disabled. Button text \"Disabled\" with hover tooltip as to reason.",
            "autoResize": true,
            "lineHeight": 1.25,
            "labelPosition": null
        },
